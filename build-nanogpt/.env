# CPU-only distributed training defaults: 4 pods x 4 processes = 16 ranks.
DEVICE=cpu
DIST_BACKEND=gloo
NNODES=4
NPROC_PER_NODE=4
NODE_RANK=0
MASTER_ADDR=nanogpt-worker-0.nanogpt-workers
MASTER_PORT=29500

# CPU thread settings. Tune these against the CPU cores allocated to each pod.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
TORCH_NUM_THREADS=1
TORCH_NUM_INTEROP_THREADS=1
CPU_BFLOAT16=0

# Mount the same pre-tokenized .npy dataset at this path on every pod.
DATA_ROOT=/data/edu_fineweb10B
LOG_DIR=/checkpoints

# Conservative starting workload for a 16-rank CPU run.
MICRO_BATCH_SIZE=1
SEQUENCE_LENGTH=1024
TOTAL_BATCH_SIZE=16384
MAX_STEPS=19073
WARMUP_STEPS=715
EVAL_INTERVAL=250
HELLASWAG_EVAL=0
