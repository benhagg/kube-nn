# CPU-only distributed training defaults. The training script hardcodes the
# CPU device and Gloo backend.
NPROC_PER_NODE=2 # num process per node
NODE_RANK=0
MASTER_ADDR=127.0.0.1
MASTER_PORT=29500

CPU_BFLOAT16=0 # set to 1 if your CPU supports bfloat16. Mine does not.

# Mount the same pre-tokenized .npy dataset at this path on every pod.
DATA_ROOT=/data
LOG_DIR=/checkpoints

# From-scratch model architecture. C must be divisible by N_HEAD.
N_LAYER=4
N_HEAD=4
C=768 # embedding dimension or hidden size.
BLOCK_SIZE=64 # basically the same as context length of model
VOCAB_SIZE=50304 # number of tokens in the tokenizer

# Conservative starting workload for a distributed run.
# Each training pass has tensors shaped (B, T, C) after token embedding.
B=1 # Concurrent batches per process
T=64 # tokens per sequence, must be <= BLOCK_SIZE
TOTAL_BATCH_SIZE=2048 # must be divisible by B * T NPROC_PER_NODE * NNODES. This is the total number of tokens processed per optimizer.step(). We average all the weights across all processes before calling optimizer.step().
MAX_STEPS=19073
WARMUP_STEPS=70
# Save after this many completed optimizer steps. Set to 0 to save only at the end.
CHECKPOINT_STEPS=5
# Set to "latest" or /checkpoints/checkpoint-00000100 to resume a saved run.
RESUME_CHECKPOINT=
